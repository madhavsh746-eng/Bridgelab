1. git clone     # for clonig the repo data
2. git add filename  # for adding a file in repo
3. git commit -m " "  # for commit
4. git add *  # only add public file in repo
5. git add .  # add all data and all private and all hidden file
6. git checkout -b "branch name" # create a branch in repo
7. git checkout branch name # for switching the branch
8. git branch  # give all branch
9. git log # give all commits value
10. git pull # take data
11. git push #push the all data file in branch and main it depend on where you push
12. git status # check all status and give all file name who you create 
